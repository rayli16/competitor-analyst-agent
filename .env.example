# Required — the app fails fast at startup (before serving anything,
# including /health) if either of these is missing. See get_api_key() in
# app/llm.py and get_tavily_api_key() in app/tools/tavily_search.py.
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Needed for tracing to actually show up, but not fail-fast — missing or
# blank Langfuse keys don't crash the app, the client just no-ops instead.
# Get these from your Langfuse Cloud project settings.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional — defaults to https://cloud.langfuse.com if unset. Only set this
# for a different Langfuse region or a self-hosted instance.
LANGFUSE_BASE_URL=
