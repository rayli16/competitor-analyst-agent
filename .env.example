# Required — the app fails fast at startup (before serving anything,
# including /health) if either of these is missing. See get_api_key() in
# app/llm.py and get_tavily_api_keys() in app/tools/tavily_search.py.
ANTHROPIC_API_KEY=sk-ant-...
# One key, or several comma-separated: tried in order, moving to the next
# when one is out of quota, rate limited, or invalid. Single-key
# TAVILY_API_KEY=tvly-... also still works.
TAVILY_API_KEYS=tvly-primary...,tvly-fallback...

# Optional — fallback model (Kimi) for when Claude fails after retries.
# Without a key, a Claude failure fails the request as before. Keys from the
# China platform (platform.moonshot.cn) need the .cn base URL below; keys
# from platform.kimi.ai can leave it blank.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=

# Needed for tracing to actually show up, but not fail-fast — missing or
# blank Langfuse keys don't crash the app, the client just no-ops instead.
# Get these from your Langfuse Cloud project settings.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional — defaults to https://cloud.langfuse.com if unset. Only set this
# for a different Langfuse region or a self-hosted instance.
LANGFUSE_BASE_URL=
